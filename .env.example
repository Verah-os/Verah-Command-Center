NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GITHUB_TOKEN=
GITHUB_OWNER=Verah-os
N8N_DISPATCHER_WEBHOOK_URL=

# Server-only. Never prefix these values with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_VERIFY_TOKEN=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_API_VERSION=
WHATSAPP_WORKER_SECRET=

# Local/test fallback. Disabled automatically in production.
WHATSAPP_SYNTHETIC_MODE=false
WHATSAPP_SYNTHETIC_APP_SECRET=
WHATSAPP_SYNTHETIC_VERIFY_TOKEN=

# Pilot Alpha demo is opt-in, synthetic, and blocked in the Vercel production environment.
VERAH_PILOT_ALPHA_SYNTHETIC_DEMO=false

# Control Plane 001 is synthetic, disabled by default and always disabled in production.
CONTROL_PLANE_DRY_RUN_ENABLED=false
CONTROL_PLANE_KILL_SWITCH=true
CONTROL_PLANE_DRY_RUN_WEBHOOK_SECRET=
CONTROL_PLANE_MAINTAINERS=
CONTROL_PLANE_MAX_DURATION_MS=30000
CONTROL_PLANE_MAX_STEPS=20
CONTROL_PLANE_MAX_COST_MICROUNITS=10000

# Local VERAH OS controller. Keep disabled until explicitly invoked.
VERAH_OS_UNATTENDED_ENABLED=false
VERAH_OS_KILL_SWITCH=true
VERAH_OS_MAINTAINERS=
VERAH_OS_MAX_DURATION_MS=7200000
VERAH_OS_LEASE_DURATION_MS=900000
VERAH_OS_MAX_CORRECTION_ATTEMPTS=2
