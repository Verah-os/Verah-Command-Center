{
  "name": "verah-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "VERAH mobile app (iOS/Android) — scaffold M1 do epico #164. Nao-producao.",
  "main": "node_modules/expo/AppEntry.js",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "doctor": "pnpm dlx expo-doctor@1",
    "check": "pnpm test && pnpm typecheck && pnpm doctor"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~55.0.31",
    "expo-location": "~55.1.14",
    "expo-system-ui": "~55.0.22",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.2.18",
    "typescript": "~5.9.3"
  }
}
