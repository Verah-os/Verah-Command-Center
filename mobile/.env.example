# Variáveis públicas (não-secret) do app mobile — somente projeto Supabase de
# não-produção. O app resolve fail-closed sem elas (src/config.ts).
# Dev local: copie para `.env` (gitignored). EAS Build: cadastre como EAS
# environment variables (`eas env:create`) — nunca comite valores reais.
EXPO_PUBLIC_SUPABASE_URL=https://<projeto-dev>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key-dev>
